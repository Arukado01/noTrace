target_include_directories(NoTracePerformanceTests PRIVATE "${NO_TRACE_PERFORMANCE_ROOT}/Engine/Include" "${NO_TRACE_PERFORMANCE_ROOT}/Games/Include")
target_compile_features(NoTracePerformanceTests PRIVATE cxx_std_20)
target_compile_definitions(NoTracePerformanceTests PRIVATE NO_TRACE_PROFILE NOMINMAX WIN32_LEAN_AND_MEAN)
target_compile_options(NoTracePerformanceTests PRIVATE $<$<CXX_COMPILER_ID:MSVC>:/utf-8>)
target_link_libraries(NoTracePerformanceTests PRIVATE SFML::Graphics SFML::Audio SFML::Network nlohmann_json::nlohmann_json spdlog::spdlog TGUI::TGUI magic_enum::magic_enum opengl32 psapi)
