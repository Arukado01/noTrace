{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build AwesomeEngine (Debug)",
            "type": "process",
            "command": "cmd",
            "args": [
                "/c",
                "${workspaceFolder}\\.vscode\\build.bat"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$msCompile"]
        },
        {
            "label": "Rebuild AwesomeEngine (Debug)",
            "type": "process",
            "command": "cmd",
            "args": [
                "/c",
                "${workspaceFolder}\\.vscode\\build.bat",
                "--clean-first"
            ],
            "group": "build",
            "problemMatcher": ["$msCompile"]
        }
    ]
}
